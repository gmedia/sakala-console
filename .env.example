PUBLIC_APP_URL=http://app.sakala.localhost:5173
PUBLIC_API_URL=http://api.sakala.localhost:8000

# Public Reverb connection metadata; leave PUBLIC_REVERB_KEY empty to disable realtime.
PUBLIC_REVERB_HOST=localhost
PUBLIC_REVERB_PORT=8080
PUBLIC_REVERB_SCHEME=http
PUBLIC_REVERB_KEY=

# The links to docs and legal documents (PUBLIC_DOCS_URL, PUBLIC_TERMS_URL, PUBLIC_ACCEPTABLE_USE_URL,
# PUBLIC_PRIVACY_URL, PUBLIC_ABUSE_EMAIL) are not read from this file: only the container sets them,
# and without them the console links to sakala.dev. See "Konfigurasi saat container start" in README.md.
