{
	"name": "sakala-console",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"packageManager": "pnpm@10.31.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest run --project server",
		"test:component": "vitest run --project client",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:component",
		"api:types": "openapi-typescript http://127.0.0.1:8000/docs/api.json -o src/lib/api/generated/schema.d.ts",
		"quality": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.3.9",
		"bits-ui": "^2.20.4",
		"clsx": "^2.1.1",
		"laravel-echo": "^2.6.3",
		"phosphor-svelte": "^3.1.1",
		"pusher-js": "^8.6.0",
		"strip-ansi": "7.2.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"lint-staged": {
		"*.{css,js,json,md,svelte,ts}": [
			"prettier --write"
		],
		"*.{js,svelte,ts}": [
			"eslint --fix"
		]
	}
}
