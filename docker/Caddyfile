{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	root * /srv

	# The console is never meant to sit in someone else's frame. X-Frame-Options covers
	# browsers older than the frame-ancestors in the policy below.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Content-Security-Policy naming this installation's API and Reverb. The image build writes it
	# from the same env file as the bundle (docker/security-headers.mjs), and docker/entrypoint.sh
	# rewrites it when the container sets other public values.
	import /run/sakala-console/security-headers.caddy

	# Every HTML response is the SPA shell: /, /index.html, and the try_files fallback below for
	# client routes such as /admin. The shell names the current build's chunks, so it is revalidated
	# on every load; a cached copy would point a reloaded tab back at chunks that are gone.
	#
	# no-transform keeps Cloudflare from rewriting the shell. Its Web Analytics (RUM) is switched on
	# for the zone and injects a static.cloudflareinsights.com/beacon.min.js script into proxied
	# HTML, which the policy above blocks and which goes against the privacy notice. Cloudflare
	# leaves a response marked no-transform alone: https://developers.cloudflare.com/web-analytics/faq/
	#
	# Matched on the response type, because try_files rewrites client routes after request matchers
	# here have run. It stays at the top level, which Caddy orders before `encode`: inside `route`,
	# `encode` would see no-transform first and send the shell uncompressed.
	header {
		match header Content-Type text/html*
		Cache-Control "no-cache, no-transform"
	}

	# `route` preserves handler order. Without it, Caddy runs `try_files`
	# before `respond`, causing the SPA fallback to mask this health endpoint.
	route {
		@health path /healthz
		respond @health "ok" 200

		# Public settings rendered by docker/entrypoint.sh, read by src/app.html before the app
		# starts. Revalidated on every load, so a restarted container's values apply at once.
		@runtimeConfig path /runtime-config.js
		handle @runtimeConfig {
			root * /run/sakala-console
			header Cache-Control "no-cache"
			file_server
		}

		# Build output never falls back to the SPA shell. A tab left open across a deploy asks for
		# hashed chunks the new image does not have; answering with index.html sends text/html for a
		# .js request. A plain 404 lets the app notice the new version instead
		# (src/lib/features/app-version/use-app-version.svelte.ts).
		@missingBuildFile {
			path /_app/*
			not file
		}
		handle @missingBuildFile {
			header Cache-Control "no-store"
			respond "Not found" 404
		}

		try_files {path} /index.html

		file_server
	}
}
